package nl.petrichor.app

/**
 * Template for the git-ignored AppConfig.kt: copy this file to AppConfig.kt (same directory)
 * and fill in your OpenWeather API key (https://openweathermap.org/api). AppConfig.kt is
 * git-ignored, so the real key is never committed.
 */
object AppConfig {
    const val OPENWEATHER_API_KEY = ""
    const val OPENWEATHER_API_BASE: String = "https://api.openweathermap.org"

    /**
     * Affiliate codes for the sponsored wardrobe items. Empty by default, so links stay plain
     * product URLs until codes are filled in here.
     */
    object AffiliateCodes {
        // Flipkart: affiliate tracking id (used as ?affid= on links and Fk-Affiliate-Id header)
        // plus the Affiliate API token (Fk-Affiliate-Token header for affiliate-api.flipkart.net).
        val flipkartCode: String? = null
        val flipkartAffiliateToken: String? = null
    }
}
