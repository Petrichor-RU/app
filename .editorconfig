root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# ktlint enforces the official Kotlin coding conventions with its defaults.
# max_line_length is intentionally left unset (rule off): the codebase predates the
# quality gate and contains long composed modifier chains that read better unbroken.
[*.{kt,kts}]
ktlint_standard = enabled
# Compose composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
